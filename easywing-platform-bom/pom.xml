<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.easywing.platform</groupId>
        <artifactId>easywing-platform</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <artifactId>easywing-platform-bom</artifactId>
    <packaging>pom</packaging>
    
    <name>EasyWing Platform BOM</name>
    <description>依赖版本管理BOM，基于2025-2026企业级标准</description>
    
    <properties>
        <!-- ==================== Spring 生态版本 ==================== -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        
        <!-- ==================== 安全框架版本 ==================== -->
        <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
        
        <!-- ==================== 数据访问层版本 ==================== -->
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <druid.version>1.2.22</druid.version>
        
        <!-- ==================== 分布式事务版本 ==================== -->
        <seata.version>2.5.0</seata.version>
        
        <!-- ==================== 服务通信版本 ==================== -->
        <grpc.version>1.64.0</grpc.version>
        <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>
        
        <!-- ==================== 容错与限流版本 ==================== -->
        <resilience4j.version>2.2.0</resilience4j.version>
        
        <!-- ==================== 可观测性版本 ==================== -->
        <opentelemetry.version>1.59.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.25.0</opentelemetry-instrumentation.version>
        
        <!-- ==================== 缓存版本 ==================== -->
        <redisson.version>3.52.0</redisson.version>
        <caffeine.version>3.1.8</caffeine.version>
        
        <!-- ==================== 消息队列版本 ==================== -->
        <rocketmq.version>2.3.6</rocketmq.version>
        
        <!-- ==================== API文档版本 ==================== -->
        <springdoc.version>2.9.0</springdoc.version>
        
        <!-- ==================== 工具库版本 ==================== -->
        <hutool.version>5.8.26</hutool.version>
        <guava.version>33.2.0-jre</guava.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.30</lombok.version>
        
        <!-- ==================== 测试框架版本 ==================== -->
        <testcontainers.version>1.19.7</testcontainers.version>
        <wiremock.version>3.5.4</wiremock.version>
        
        <native-maven-plugin.version>0.10.2</native-maven-plugin.version>
        
        <!-- ==================== 其他工具版本 ==================== -->
        <jwt.version>0.12.6</jwt.version>

        <!-- ==================== AI 与测试工具版本 ==================== -->
        <commons-text.version>1.11.0</commons-text.version>
        <json-schema-validator.version>1.0.87</json-schema-validator.version>
        <testcontainers-redis.version>2.2.0</testcontainers-redis.version>

        <!-- LangChain4j：全量 1.x，由 BOM 统一收敛；
             Qwen 通过 DashScope 的 OpenAI 兼容端点接入，无需 dashscope 模块 -->
        <langchain4j.version>1.23.0</langchain4j.version>
        <!-- embeddings 单独发版，1.23.0-beta33 是该 artifact 在 Maven Central 的最新 release，
             不存在 1.23.0 正式版，因此与 langchain4j.version 不同属正常现象 -->
        <langchain4j-embeddings.version>1.23.0-beta33</langchain4j-embeddings.version>
    </properties>
    
