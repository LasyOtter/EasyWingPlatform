<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.easywing.platform</groupId>
    <artifactId>easywing-platform-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../easywing-platform-parent/pom.xml</relativePath>
  </parent>

  <artifactId>easywing-platform-led</artifactId>
  <packaging>jar</packaging>

  <name>EasyWing Platform LED Service</name>
  <description>LED 显示服务 - 多厂商控制卡适配、节目下发、内码实时刷新、数据源与屏管理</description>

  <properties>
    <onbon-bx06.version>0.6.5-SNAPSHOT</onbon-bx06.version>
    <uia-comm.version>0.5.3-SNAPSHOT</uia-comm.version>
    <uia-message.version>0.6.0</uia-message.version>
    <uia-utils.version>0.3.1</uia-utils.version>
    <simple-xml.version>2.7.1</simple-xml.version>
    <rxtx.version>2.1.7</rxtx.version>
  </properties>

  <dependencies>
    <!-- EasyWing Starters -->
    <dependency>
      <groupId>com.easywing.platform</groupId>
      <artifactId>easywing-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.easywing.platform</groupId>
      <artifactId>easywing-boot-starter-data</artifactId>
    </dependency>
    <dependency>
      <groupId>com.easywing.platform</groupId>
      <artifactId>easywing-boot-starter-security-oauth2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.easywing.platform</groupId>
      <artifactId>easywing-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.easywing.platform</groupId>
      <artifactId>easywing-boot-starter-otel</artifactId>
    </dependency>

    <!-- Nacos Discovery -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- Spring Boot -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 实体 ↔ DTO/VO 映射 -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 数据库迁移 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- MySQL 驱动：服务自身库 + JDBC 数据源共用 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- YAML 配置解析（三层 YAML 配置） -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- 仰邦（onbon bx06）官方纯 Java SDK，本地 jar 已 install 到仓库 -->
    <dependency>
      <groupId>onbon.bx06</groupId>
      <artifactId>bx06</artifactId>
      <version>${onbon-bx06.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>onbon.bx06</groupId>
      <artifactId>bx06.message</artifactId>
      <version>${onbon-bx06.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>uia</groupId>
      <artifactId>uia-comm</artifactId>
      <version>${uia-comm.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>uia</groupId>
      <artifactId>uia-message</artifactId>
      <version>${uia-message.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>uia</groupId>
      <artifactId>uia-utils</artifactId>
      <version>${uia-utils.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.simple-xml</groupId>
      <artifactId>simple-xml</artifactId>
      <version>${simple-xml.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.rxtx</groupId>
      <artifactId>rxtx</artifactId>
      <version>${rxtx.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- API 文档 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
