# 应用标题
VITE_APP_TITLE=EasyWing Platform

# API 基础路径
VITE_APP_BASE_API=/api

# 开发服务器端口
VITE_APP_PORT=8080

# 是否启用 Mock 数据
VITE_APP_USE_MOCK=true

# 是否启用权限控制
VITE_APP_PERMISSION=true

# Token 名称
VITE_APP_TOKEN_NAME=X-Access-Token

# 路由基础路径（默认空）
VITE_APP_ROUTER_BASE=

# 是否开启 Sourcemap
VITE_APP_SOURCEMAP=false
